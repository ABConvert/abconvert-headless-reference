# Copy to .env.local. Every value is optional for a first look.

# Shopify Storefront API. With no domain, the store reads hardware.mock.shop,
# Shopify's public sample catalog: pages and carts work, but no ABConvert test
# can run there, since ABConvert is not installed on it.
# From the Headless channel (Sales channels, Headless, your storefront, Storefront
# API tokens). The private token is used when set, on the server only.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_TOKEN=

# ABConvert. The store domain and the storefront key from the ABConvert admin
# (Settings, Headless Storefront). Without them the store shows your original
# prices and pages, and the server logs [abconvert] errors.
ABCONVERT_SHOP=
ABCONVERT_STOREFRONT_KEY=

# 1 lets the CDN cache tested pages. Set it only after the CDN's cache key
# includes the abconvert-key cookie AND abconvert_force, abconvert_preview_key,
# abconvert_experiment_id query parameters. See README before enabling.
ABCONVERT_CDN_KEYED_BY_COOKIE=

# The site's public origin, for canonical URLs.
SITE_URL=http://localhost:3000

# Shared secret for POST /api/revalidate, which refreshes a product page on demand.
REVALIDATE_SECRET=

# Show the ABConvert panel in a production build (it always shows in `npm run dev`).
NEXT_PUBLIC_ABCONVERT_DEBUG=
