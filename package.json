{
  "name": "abconvert-headless-reference",
  "version": "0.1.0",
  "private": true,
  "description": "A reference Next.js storefront that runs ABConvert tests with @abconvert/headless, set up like a Next.js 14 App Router store behind Google Cloud CDN.",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "cdn": "node scripts/cdn.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "check:redirect": "node scripts/check-redirect.mjs"
  },
  "dependencies": {
    "@abconvert/headless": "^0.1.4",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "5.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
